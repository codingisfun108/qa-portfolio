# Copy to .env.local for local development. In Vercel, add the same keys under
# Project > Settings > Environment Variables.

# --- Admin login (required to use /admin) ---
ADMIN_EMAIL=you@example.com
# Run `npm run hash-password` and paste the result. Never put the plain password here.
ADMIN_PASSWORD_HASH=
# Random string, 32+ characters. `npm run hash-password` prints one for you.
SESSION_SECRET=

# --- Storage (added automatically when you connect them in Vercel > Storage) ---
# Upstash for Redis: stores content and contact messages. Either pair of names works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Vercel Blob: stores uploaded photos and PDFs.
# BLOB_READ_WRITE_TOKEN=

# --- Optional: email me when someone uses the contact form (resend.com free tier) ---
# RESEND_API_KEY=
# NOTIFY_EMAIL=you@example.com
# NOTIFY_FROM="Portfolio <onboarding@resend.dev>"

# Local only: where content is stored when Redis isn't configured.
# DATA_DIR=.data
